// LAYERS

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUNC    3

// MACROS

#define SUPER LC(LSHIFT)
#define SUPER2 LA(LC(LSHIFT))

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&hm RGUI SEMI>, <&kp SQT>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_1";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL TAB>, <&kp ESC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_cword {
            timeout-ms = <50>;
            key-positions = <16 19>;
            bindings = <&caps_word>;
        };

        combo_vimwq {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&vim_quit>;
        };
    };

    macros {
        vim_quit: vim_quit {
            label = "ZM_vim_quit";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp ESC &kp COLON &kp W &kp Q>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &kp Q             &kp W       &kp E          &kp R             &kp T             &kp Y      &kp U          &kp I            &kp O    &kp P     &none
&none  &hm LEFT_SHIFT A  &hm LALT S  &hm LCTRL D    &hm LEFT_META F   &kp G             &kp H      &kp J          &kp K            &kp L    &td0      &none
&none  &kp Z             &kp X       &kp C          &kp V             &kp B             &kp N      &kp M          &kp COMMA        &kp DOT  &kp FSLH  &none
                                     &mt LCTRL TAB  &mt LEFT_ALT ESC  &mt LGUI SPACE    &lt 1 RET  &lt SYM GRAVE  &lt 3 BACKSPACE
            >;
        };

        num_layer {
            bindings = <
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5           &kp NUMBER_6    &kp N7          &kp N8        &kp N9     &kp N0    &none
&none  &vim_quit     &trans        &trans        &kp HOME      &kp PG_UP        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp SQT   &none
&none  &kp SUPER2    &none         &none         &kp END       &kp PAGE_DOWN    &kp N0          &kp N1          &kp N2        &kp N3     &kp BSLH  &none
                                   &trans        &trans        &trans           &trans          &mo FUNC        &trans
            >;
        };

        sym_layer {
            bindings = <
&none  &kp EXCL   &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &none
&none  &trans     &trans  &trans    &trans    &none        &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &none
&none  &kp TILDE  &none   &none     &none     &none        &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &none
                          &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        func_layer {
            bindings = <
&none  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5              &kp F1  &kp F2   &kp F3   &kp F4   &none            &none
&none  &none         &none         &kp C_PREV    &kp K_MUTE    &kp C_PLAY_PAUSE    &kp F5  &kp F6   &kp F7   &kp F8   &kp RIGHT_SHIFT  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_NXT    &bt BT_CLR          &kp F9  &kp F10  &kp F11  &kp F12  &none            &none
                                   &kp LCTRL     &kp LEFT_ALT  &kp LEFT_GUI        &none   &trans   &trans
            >;
        };
    };
};
